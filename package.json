{
  "name": "psi-monitor",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "description": "Dev-only manifest so Node treats the .js files as ES modules (tests, syntax check). Not shipped with the extension.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  }
}
